<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MeuDesenho" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/linho</item>
        <item name="android:colorBackground">@color/linho</item>
        <item name="android:statusBarColor">@color/linho</item>
        <item name="android:navigationBarColor">@color/linho</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.MeuDesenho.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nanquim</item>
        <item name="android:colorBackground">@color/nanquim</item>
        <item name="android:statusBarColor">@color/nanquim</item>
        <item name="android:navigationBarColor">@color/nanquim</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
