<?xml version="1.0" encoding="utf-8"?>
<!-- Fraunces no papel de display: SOFT 60 / WONK 0, como o mockup declara em
     `h1,h2,h3`. O eixo `opsz` fica no corpo do display para o contraste sair
     igual ao da tela. Fonte OFL, subset latin (ver assets/OFL-Fraunces.txt). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/fraunces"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 400, 'SOFT' 60, 'WONK' 0, 'opsz' 24"
        android:fontWeight="400" />
</font-family>

